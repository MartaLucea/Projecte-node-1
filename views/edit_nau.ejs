<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar nau</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="pont">
        <div class="contingut">
            <header>
                <p class="enllacos">
                    <a class="enllac" href="/protected">Pont</a>
                    <a class="enllac" href="/flota">Flota</a>
                    <a class="enllac" href="/naus">Naus</a>
                    <a class="enllac" href="/personatges">Personatges</a>
                    <a class="enllac" href="/profile">Perfil</a>
                    <a class="enllac" href="#" id="close-session">Tancar sessió</a>
                </p>
                <p class="etiqueta">Registre de naus</p>
                <h1>Editar nau</h1>
            </header>

            <main>
                <% if (error) { %>
                    <p class="avis"><%= error %></p>
                <% } %>

                <form class="formulari" action="/naus/<%= nau.id %>?_method=PUT" method="POST">
                    <div class="camp">
                        <label for="nom">Nom</label>
                        <input type="text" id="nom" name="nom" value="<%= nau.nom || '' %>" required>
                    </div>

                    <div class="camp">
                        <label for="registre">Registre</label>
                        <input type="text" id="registre" name="registre" value="<%= nau.registre || '' %>" required>
                    </div>

                    <div class="camp">
                        <label for="classe">Classe</label>
                        <input type="text" id="classe" name="classe" value="<%= nau.classe || '' %>" required>
                    </div>

                    <div class="camp">
                        <label for="capacitat">Capacitat</label>
                        <input type="number" id="capacitat" name="capacitat" value="<%= nau.capacitat || '' %>" min="1" step="1" required>
                    </div>

                    <div class="camp">
                        <label for="estat">Estat</label>
                        <select id="estat" name="estat" required>
                        <% estats.forEach(estat => { %>
                            <option value="<%= estat %>" <%= nau.estat === estat ? 'selected' : '' %>><%= estat %></option>
                        <% }) %>
                    </select>
                    </div>

                    <button type="submit" class="boto">Desar canvis</button>
                </form>

                <form class="formulari perill" action="/naus/<%= nau.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Estàs segur que vols eliminar aquesta nau?');">
                    <button type="submit" class="boto perill">Eliminar nau</button>
                </form>

                <a class="enllac" href="/naus">Tornar al llistat</a>
            </main>
        </div>
    </div>
    <script src="/js/register.js"></script>
</body>
</html>
